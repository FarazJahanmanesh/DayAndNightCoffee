<style>
    .page-header {
        background-color: rgb(217, 217, 217);
        width: 100%;
        padding: 20px 0;
        margin: 0;
    }

    .page-title {
        text-align: center;
        font-size: 80px;
        margin: 0;
        padding: 0;
        width: 100%;
        display: block;
    }

    .page-footer {
        background-color: rgb(191, 191, 191);
        width: 100%;
        padding: 20px 0;
        margin: 0;
    }

    .footer-text {
        text-align: center;
        font-size: 25px;
        margin: 0;
        padding: 0;
        width: 100%;
        display: block;
    }

    body {
        margin: 0;
        padding: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .content {
        flex: 1;
    }
</style>

<div class="page-header">
    <h1 class="page-title">Day & Night</h1>
</div>

<div class="content">
    @RenderBody()
</div>

<div class="page-footer">
    <h1 class="footer-text">
        برای قهوه بیا برای دوستی بمان
    </h1>
</div>